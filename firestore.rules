rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{uid} {
      allow read, write: if uid == 'demo-business' || (request.auth != null && request.auth.uid == uid);

      match /transactions/{transactionId} {
        allow read, write: if uid == 'demo-business' || (request.auth != null && request.auth.uid == uid);
      }

      match /products/{productId} {
        allow read, write: if uid == 'demo-business' || (request.auth != null && request.auth.uid == uid);
      }

      match /orders/{orderId} {
        allow read: if uid == 'demo-business' || (request.auth != null && request.auth.uid == uid);
        allow write: if false;
      }

      match /shopSessions/{phone} {
        allow read, write: if false;
      }

      match /counters/{counterId} {
        allow read: if uid == 'demo-business' || (request.auth != null && request.auth.uid == uid);
        allow write: if false;
      }
    }

    match /mpesaCheckouts/{checkoutRequestId} {
      allow read, write: if false;
    }
  }
}
