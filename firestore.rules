rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // The shopkeeper manages their own catalog from the dashboard.
      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Orders are read-only from the browser. They're created by the WhatsApp
      // webhook and settled by the M-Pesa callback, both of which use the Admin
      // SDK and bypass these rules — so allowing client writes would only ever
      // let a shopkeeper rewrite what a customer actually paid.
      match /orders/{orderId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Customers' in-progress carts. Server-side only: the customer has no
      // ChatBooks account, and the owner has no reason to reach in.
      match /shopSessions/{phone} {
        allow read, write: if false;
      }

      // The monotonic KRA invoice counter. Editable only by the server, since
      // reusing a number would misfile a return.
      match /counters/{counterId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // CheckoutRequestID → {uid, orderId}, written and read only by the M-Pesa
    // callback route via the Admin SDK. Nothing in a browser should see it:
    // it maps payment identifiers across every tenant.
    match /mpesaCheckouts/{checkoutRequestId} {
      allow read, write: if false;
    }
  }
}
