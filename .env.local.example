NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Go WhatsApp Web Multi-Device integration
# URL where the GoWA REST server is running (default: http://localhost:3000)
NEXT_PUBLIC_GOWA_URL=http://localhost:3000

# Anthropic API key, used server-side only by /api/ocr/receipt for real
# receipt-photo OCR via Claude vision. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Shared secret ChatBooks uses to verify the X-Hub-Signature-256 header on
# incoming /api/webhook/whatsapp requests. Must match --chatbooks-webhook-secret
# (or WHATSAPP_CHATBOOKS_WEBHOOK_SECRET) on the Go WhatsApp server.
CHATBOOKS_WEBHOOK_SECRET=

# Firebase Admin SDK credentials, used server-side only by the webhook route
# to write Firestore without a browser auth session. Leave unset to fall
# back to Application Default Credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Anthropic API key — used server-side only, by /api/ai/parse-transaction and
# the WhatsApp webhook, to turn chat messages into ledger entries with Claude.
# Deliberately NOT prefixed NEXT_PUBLIC_: that prefix inlines a value into the
# browser bundle, which would publish the key to every visitor.
# Without it the app falls back to the keyword parser in lib/ai/parseTransaction.ts.
ANTHROPIC_API_KEY=

# ─── M-Pesa (Safaricom Daraja) ───────────────────────────────────────────────
# Credentials for STK Push, used server-side only by the WhatsApp shopping flow
# and /api/mpesa/callback. These move real money — never prefix them
# NEXT_PUBLIC_, and never commit a filled-in .env.local (see .gitignore).
#
# From an app on https://developer.safaricom.co.ke:
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# "sandbox" (default) or "production" — selects the Daraja base URL.
MPESA_ENV=sandbox

# Your paybill or till number, and the Lipa na M-Pesa Online passkey issued
# with it.
MPESA_SHORTCODE=
MPESA_PASSKEY=

# CustomerPayBillOnline (default, paybill) or CustomerBuyGoodsOnline (till).
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Only needed when the receiving till differs from MPESA_SHORTCODE; defaults to
# MPESA_SHORTCODE.
MPESA_PARTY_B=

# Public HTTPS URL Safaricom POSTs the payment result to. Must be reachable
# from the internet — use a tunnel in development. Include the token below as a
# query parameter, e.g.
#   https://your-app.example.com/api/mpesa/callback?token=THE_TOKEN
MPESA_CALLBACK_URL=

# Shared secret checked against ?token= on the callback. Daraja does not sign
# its callbacks, so this is the only thing standing between the endpoint and
# the open internet. Note the route never trusts the callback's Amount — it
# records the stored order total — so the worst a forged callback can do is
# mark an existing order paid.
MPESA_CALLBACK_TOKEN=

# ─── KRA eTIMS ───────────────────────────────────────────────────────────────
# Only "stub" is implemented today: filings are logged and marked "Simulated"
# in the dashboard rather than sent to KRA. Add a real provider in
# lib/etims/provider.ts and select it here once you're onboarded.
ETIMS_PROVIDER=stub
