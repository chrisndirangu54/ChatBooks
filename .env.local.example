NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Go WhatsApp Web Multi-Device integration
# URL where the GoWA REST server is running (default: http://localhost:3000)
NEXT_PUBLIC_GOWA_URL=http://localhost:3000

# Anthropic API key, used server-side only by /api/ocr/receipt for real
# receipt-photo OCR via Claude vision. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Shared secret ChatBooks uses to verify the X-Hub-Signature-256 header on
# incoming /api/webhook/whatsapp requests. Must match --chatbooks-webhook-secret
# (or WHATSAPP_CHATBOOKS_WEBHOOK_SECRET) on the Go WhatsApp server.
CHATBOOKS_WEBHOOK_SECRET=

# Firebase Admin SDK credentials, used server-side only by the webhook route
# to write Firestore without a browser auth session. Leave unset to fall
# back to Application Default Credentials.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Anthropic API key — used server-side only, by /api/ai/parse-transaction and
# the WhatsApp webhook, to turn chat messages into ledger entries with Claude.
# Deliberately NOT prefixed NEXT_PUBLIC_: that prefix inlines a value into the
# browser bundle, which would publish the key to every visitor.
# Without it the app falls back to the keyword parser in lib/ai/parseTransaction.ts.
ANTHROPIC_API_KEY=
